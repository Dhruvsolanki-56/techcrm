# Copy to .env (never commit it). Every value is optional for local development.
PORT=3000
# Folder for crm.db, uploads/ and backups/
CRM_DATA_DIR=./data
# Encrypts stored credentials. 16+ characters. Keep a copy somewhere safe: losing it makes saved passwords unreadable.
# CRM_SECRET=
# Number of reverse proxies in front of the app (Render / Caddy / nginx = 1)
TRUST_PROXY=0
SESSION_HOURS=12
BACKUP_KEEP=14
LOG_LEVEL=info

# Seed only
# CRM_FOUNDER_EMAIL=you@example.com
# CRM_SEED_PASSWORD=
